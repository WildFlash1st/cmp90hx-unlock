+    status = kgspCmp90InstallV67SignatureForBooter(pGpu, pKernelGsp);
+    if (status != NV_OK)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+                  "CMP90_STOCKFLOW_POSTINIT1: install V67 signature "
+                  "failed status=0x%x\n", status);
+        return status;
+    }
+
+    if (sysmemAddrOfData != 0)
+    {
+        mailbox0 = NvU64_LO32(sysmemAddrOfData);
+        mailbox1 = NvU64_HI32(sysmemAddrOfData);
+    }
+
+    NV_PRINTF(
+        LEVEL_ERROR,
+        "CMP90_STOCKFLOW_POSTINIT1: invoking V67 Booter after "
+        "stock GSP-RM ready feat_plm_before=0x%08x "
+        "mailbox0=0x%08x mailbox1=0x%08x\n",
+        featPlmBefore, mailbox0, mailbox1);
