+    }
+
+    featPlmAfter = GPU_REG_RD32(pGpu, CMP90_POSTINIT1_FEAT_OVR_PLM);
+    wpr2LoRaw = GPU_REG_RD32(pGpu, NV_PFB_PRI_MMU_WPR2_ADDR_LO);
+    wpr2HiRaw = GPU_REG_RD32(pGpu, NV_PFB_PRI_MMU_WPR2_ADDR_HI);
+    cpuCtl = kflcnRegRead_HAL(pGpu, pKernelFlcn, NV_PFALCON_FALCON_CPUCTL);
+    irqStat = kflcnRegRead_HAL(pGpu, pKernelFlcn, NV_PFALCON_FALCON_IRQSTAT);
+    debugInfo = kflcnRegRead_HAL(pGpu, pKernelFlcn, NV_PFALCON_FALCON_DEBUGINFO);
