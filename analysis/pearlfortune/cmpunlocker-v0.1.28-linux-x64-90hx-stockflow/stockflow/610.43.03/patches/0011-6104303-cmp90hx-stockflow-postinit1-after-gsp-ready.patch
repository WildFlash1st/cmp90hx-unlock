+    restoreStatus = kgspCmp90RestoreStockSignatureForBooter(pGpu, pKernelGsp);
+    NV_PRINTF(
+        LEVEL_ERROR,
+        "CMP90_STOCKFLOW_POSTINIT1: post hook complete "
+        "status=0x%x restore_status=0x%x "
+        "feat_plm_before=0x%08x feat_plm_after=0x%08x "
+        "wpr2_lo_raw=0x%08x wpr2_hi_raw=0x%08x "
+        "cpu_ctl=0x%08x irq_stat=0x%08x debug_info=0x%08x "
+        "trace_idx=0x%08x trace_pc=0x%08x\n",
+        status, restoreStatus, featPlmBefore, featPlmAfter,
+        wpr2LoRaw, wpr2HiRaw, cpuCtl, irqStat, debugInfo,
+        traceIdx, tracePc);
