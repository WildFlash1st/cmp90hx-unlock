+    NvU32 tracePc;
+    KernelSec2 *pKernelSec2 = GPU_GET_KERNEL_SEC2(pGpu);
+    KernelFalcon *pKernelFlcn = staticCast(pKernelSec2, KernelFalcon);
+
+    if (!_kgspCmp90Postinit1IsExactTarget(pGpu))
+    {
+        return NV_OK;
+    }
+
+    featPlmBefore = GPU_REG_RD32(pGpu, CMP90_POSTINIT1_FEAT_OVR_PLM);
+    if (featPlmBefore == CMP90_POSTINIT1_PLM_OPEN)
+    {
+        NV_PRINTF(
+            LEVEL_ERROR,
+            "CMP90_STOCKFLOW_POSTINIT1: PLM already open after "
+            "stock GSP-RM ready; skipping post hook\n");
+        return NV_OK;
+    }
+
+    NV_ASSERT_OR_RETURN(pKernelGsp->pBooterLoadUcode != NULL,
+                        NV_ERR_INVALID_STATE);
+    NV_ASSERT_OR_RETURN(pKernelSec2 != NULL, NV_ERR_INVALID_STATE);
