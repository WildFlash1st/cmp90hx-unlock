+        (unsigned long long)oldSignatureSize,
+        (unsigned long long)CMP90_POSTINIT1_SIGNATURE_SIZE);
+
+    return NV_OK;
+
+fail_alloc:
+    if (pNewSignatureMemdesc != NULL)
+    {
+        memdescFree(pNewSignatureMemdesc);
+    }
+
+fail_create:
+    if (pNewSignatureMemdesc != NULL)
+    {
+        memdescDestroy(pNewSignatureMemdesc);
+    }
+
+    return status;
+}
