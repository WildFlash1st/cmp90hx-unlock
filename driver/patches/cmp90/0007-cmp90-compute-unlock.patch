+static void
+_kgspCmp90PutU32(NvU8 *pBuffer, NvU32 offset, NvU32 value)
+{
+    pBuffer[offset + 0] = (NvU8)(value >>  0);
+    pBuffer[offset + 1] = (NvU8)(value >>  8);
+    pBuffer[offset + 2] = (NvU8)(value >> 16);
+    pBuffer[offset + 3] = (NvU8)(value >> 24);
+}
+
+static void
+_kgspCmp90FillPayload(NvU8 *pSignatureVa, NvU64 signatureSize,
+                       NvU32 writeAddr, NvU32 writeValue)
+{
+    NvU64 i;
+
+    for (i = 0; i + sizeof(NvU32) <= signatureSize; i += sizeof(NvU32))
+        _kgspCmp90PutU32(pSignatureVa, (NvU32)i, CMP90_SIGNATURE_FILL_DWORD);
+
+    _kgspCmp90PutU32(pSignatureVa, 0x1100, 0x00000007U);
+    _kgspCmp90PutU32(pSignatureVa, 0x5b40, 0xc0deca7eU);
+
+    _kgspCmp90PutU32(pSignatureVa, 0xf754, writeValue);
+    _kgspCmp90PutU32(pSignatureVa, 0xf758, 0xc0deca7eU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf75c, 0x00000cbdU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf76c, writeAddr);
+    _kgspCmp90PutU32(pSignatureVa, 0xf774, 0x00001fbdU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf780, 0x00000000U);
+    _kgspCmp90PutU32(pSignatureVa, 0xf788, 0x000010aaU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf78c, 0x0000815aU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf790, 0x00008e18U);
+    _kgspCmp90PutU32(pSignatureVa, 0xf794, 0xc0deca7eU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf798, 0x0000815aU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf79c, 0x00000000U);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7a0, 0xc0deca7eU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7a4, 0x00001fbdU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7b0, 0x0000ffbcU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7b8, 0x0000582dU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7c4, 0xc0deca7eU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7c8, 0x00000cbdU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7d8, 0x00000003U);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7e0, 0x00001fbdU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7f4, 0x00000ccbU);
+    _kgspCmp90PutU32(pSignatureVa, 0xf7f8, 0x00007f2fU);
+}
+
+NV_STATUS
+kgspCmp90RefillPayload(OBJGPU *pGpu, KernelGsp *pKernelGsp,
+                        NvU32 writeAddr, NvU32 writeValue)
+{
+    NvU8 *pSignatureVa;
+
+    if (pKernelGsp->pSignatureMemdesc == NULL)
+        return NV_ERR_INVALID_STATE;
+
+    pSignatureVa = memdescMapInternal(pGpu, pKernelGsp->pSignatureMemdesc, TRANSFER_FLAGS_NONE);
+    if (pSignatureVa == NULL)
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+
+    _kgspCmp90FillPayload(pSignatureVa,
+        memdescGetSize(pKernelGsp->pSignatureMemdesc), writeAddr, writeValue);
+
+    memdescUnmapInternal(pGpu, pKernelGsp->pSignatureMemdesc, 0);
+    memdescFlushCpuCaches(pGpu, pKernelGsp->pSignatureMemdesc);
+
+    if (pKernelGsp->pWprMeta != NULL)
+    {
+        pKernelGsp->pWprMeta->sysmemAddrOfSignature =
+            memdescGetPhysAddr(pKernelGsp->pSignatureMemdesc, AT_GPU, 0);
+        pKernelGsp->pWprMeta->sizeOfSignature =
+            memdescGetSize(pKernelGsp->pSignatureMemdesc);
+    }
+
+    if (pKernelGsp->pWprMetaDescriptor != NULL)
+        memdescFlushCpuCaches(pGpu, pKernelGsp->pWprMetaDescriptor);
+
+    return NV_OK;
+}
