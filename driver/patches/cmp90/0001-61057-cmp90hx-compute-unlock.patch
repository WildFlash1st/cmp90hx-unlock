 #include "crashcat/crashcat_report.h"
 
+#define CMP90HX_PCI_DEVICE_ID                  0x220DU
+#define CMP90HX_PCI_SUBDEVICE_ID               0x155510DEU
+#define CMP90HX_SIGNATURE_SIZE                 0x0000FA00ULL
+#define CMP90HX_SIGNATURE_FILL_DWORD           0x0000019CU
+#define CMP90HX_FEAT_OVR_PLM                   0x00823804U
+#define CMP90HX_FEAT_OVR_SM_SPD                0x0082381CU
+#define CMP90HX_FEAT_OVR_SM_SPD_1              0x00823820U
+
+static NvBool
+_kgspCmp90hxEnabled(OBJGPU *pGpu)
+{
+    return (((pGpu->idInfo.PCIDeviceID >> 16) == CMP90HX_PCI_DEVICE_ID) &&
+            (pGpu->idInfo.PCISubDeviceID == CMP90HX_PCI_SUBDEVICE_ID));
+}
+
+static NV_STATUS _kgspCmp90hxRefillOpenPlmPayload(OBJGPU *pGpu,
+    KernelGsp *pKernelGsp);
+static NV_STATUS _kgspCmp90hxRestoreStockSignature(OBJGPU *pGpu,
+    KernelGsp *pKernelGsp);
+
+NV_STATUS kgspCmp90hxApplyComputeOverrides(OBJGPU *pGpu,
+    KernelGsp *pKernelGsp, NvU64 booterLoadArgs);
+
 
 struct MIG_CI_UPDATE_CALLBACK_PARAMS
