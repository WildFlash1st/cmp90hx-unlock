     pKernelGsp->gspRmBootUcodeSize   = 0;
 }
 
+static void
+_kgspCmp90hxPutU32
+(
+    NvU8 *pBuffer,
+    NvU32 offset,
+    NvU32 value
+)
+{
+    pBuffer[offset + 0] = (NvU8)(value >> 0);
+    pBuffer[offset + 1] = (NvU8)(value >> 8);
+    pBuffer[offset + 2] = (NvU8)(value >> 16);
+    pBuffer[offset + 3] = (NvU8)(value >> 24);
+}
+
+static void
+_kgspCmp90hxFillOpenPlmPayload
+(
+    NvU8 *pSignatureVa,
+    NvU64 signatureSize
+)
+{
+    NvU64 i;
+
+    for (i = 0; i + sizeof(NvU32) <= signatureSize; i += sizeof(NvU32))
+        _kgspCmp90hxPutU32(pSignatureVa, (NvU32)i,
+            CMP90HX_SIGNATURE_FILL_DWORD);
+
+    /* 610.x gadget addresses - verified via objdump */
+    _kgspCmp90hxPutU32(pSignatureVa, 0x1100, 0x00000007U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf948, 0xffffffffU);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf950, 0x00000d2aU);  /* was 0x00000d44 in 580.x */
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf960, CMP90HX_FEAT_OVR_PLM);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf968, 0x0000209cU);  /* was 0x00001fce in 580.x */
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf974, 0x00000000U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf97c, 0x00001101U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf980, 0x000084c8U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf984, 0x00008e18U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf98c, 0x000084c8U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf990, 0x00000000U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf998, 0x0000209cU);  /* was 0x00001fce in 580.x */
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9a4, 0x0000ffbcU);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9ac, 0x00005789U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9bc, 0x00000d2aU);  /* was 0x00000d44 in 580.x */
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9cc, 0x00000003U);
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9d4, 0x0000209cU);  /* was 0x00001fce in 580.x */
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9e8, 0x00000d38U);  /* was 0x00000d52 in 580.x */
+    _kgspCmp90hxPutU32(pSignatureVa, 0xf9ec, 0x000081eeU);
+}
+
+static NV_STATUS
+_kgspCmp90hxRefillOpenPlmPayload
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp
+)
+{
+    NvU8 *pSignatureVa;
+
+    if (pKernelGsp->pSignatureMemdesc == NULL)
+        return NV_ERR_INVALID_STATE;
+
+    pSignatureVa = memdescMapInternal(pGpu, pKernelGsp->pSignatureMemdesc,
+        TRANSFER_FLAGS_NONE);
+    if (pSignatureVa == NULL)
+        return NV_ERR_INSUFFICIENT_RESOURCES;
+
+    _kgspCmp90hxFillOpenPlmPayload(pSignatureVa,
+        memdescGetSize(pKernelGsp->pSignatureMemdesc));
+    memdescUnmapInternal(pGpu, pKernelGsp->pSignatureMemdesc, 0);
+    memdescFlushCpuCaches(pGpu, pKernelGsp->pSignatureMemdesc);
+
+    if (pKernelGsp->pWprMeta != NULL)
+    {
+        pKernelGsp->pWprMeta->sysmemAddrOfSignature =
+            memdescGetPhysAddr(pKernelGsp->pSignatureMemdesc, AT_GPU, 0);
+        pKernelGsp->pWprMeta->sizeOfSignature =
+            memdescGetSize(pKernelGsp->pSignatureMemdesc);
+    }
+    if (pKernelGsp->pWprMetaDescriptor != NULL)
+        memdescFlushCpuCaches(pGpu, pKernelGsp->pWprMetaDescriptor);
+
+    return NV_OK;
+}
+
+static NV_STATUS
+_kgspCmp90hxRestoreStockSignature
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp
+)
+{
+    NV_STATUS status = NV_OK;
+    NvU8 *pSignatureVa = NULL;
+    NvU64 flags = MEMDESC_FLAGS_NONE;
+
+    if ((pKernelGsp->pCmp90StockSignatureData == NULL) ||
+        (pKernelGsp->cmp90StockSignatureSize == 0))
+        return NV_ERR_INVALID_STATE;
+
+    if (pKernelGsp->pSignatureMemdesc != NULL)
+    {
+        memdescFree(pKernelGsp->pSignatureMemdesc);
+        memdescDestroy(pKernelGsp->pSignatureMemdesc);
+        pKernelGsp->pSignatureMemdesc = NULL;
+    }
+
+    flags |= MEMDESC_FLAGS_ALLOC_IN_UNPROTECTED_MEMORY;
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        memdescCreate(&pKernelGsp->pSignatureMemdesc, pGpu,
+            NV_ALIGN_UP(pKernelGsp->cmp90StockSignatureSize, 256), 256,
+            NV_TRUE, ADDR_SYSMEM, NV_MEMORY_CACHED, flags));
+
+    memdescTagAlloc(status, NV_FB_ALLOC_RM_INTERNAL_OWNER_UNNAMED_TAG_16,
+        pKernelGsp->pSignatureMemdesc);
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR, status, fail_create);
+
+    pSignatureVa = memdescMapInternal(pGpu, pKernelGsp->pSignatureMemdesc,
+        TRANSFER_FLAGS_NONE);
+    NV_CHECK_OK_OR_GOTO(status, LEVEL_ERROR,
+        (pSignatureVa != NULL) ? NV_OK : NV_ERR_INSUFFICIENT_RESOURCES,
+        fail_alloc);
+
+    portMemCopy(pSignatureVa, memdescGetSize(pKernelGsp->pSignatureMemdesc),
+        pKernelGsp->pCmp90StockSignatureData,
+        pKernelGsp->cmp90StockSignatureSize);
+    memdescUnmapInternal(pGpu, pKernelGsp->pSignatureMemdesc, 0);
+    memdescFlushCpuCaches(pGpu, pKernelGsp->pSignatureMemdesc);
+    portMemFree(pKernelGsp->pCmp90StockSignatureData);
+    pKernelGsp->pCmp90StockSignatureData = NULL;
+    pKernelGsp->cmp90StockSignatureSize = 0;
+
+    if (pKernelGsp->pWprMeta != NULL)
+    {
+        pKernelGsp->pWprMeta->sysmemAddrOfSignature =
+            memdescGetPhysAddr(pKernelGsp->pSignatureMemdesc, AT_GPU, 0);
+        pKernelGsp->pWprMeta->sizeOfSignature =
+            memdescGetSize(pKernelGsp->pSignatureMemdesc);
+    }
+    if (pKernelGsp->pWprMetaDescriptor != NULL)
+        memdescFlushCpuCaches(pGpu, pKernelGsp->pWprMetaDescriptor);
+
+    return NV_OK;
+
+fail_alloc:
+    memdescFree(pKernelGsp->pSignatureMemdesc);
+fail_create:
+    memdescDestroy(pKernelGsp->pSignatureMemdesc);
+    pKernelGsp->pSignatureMemdesc = NULL;
+    return status;
+}
+
+NV_STATUS
+kgspCmp90hxApplyComputeOverrides
+(
+    OBJGPU *pGpu,
+    KernelGsp *pKernelGsp,
+    NvU64 booterLoadArgs
+)
+{
+    NV_STATUS status;
+    NvU32 attempt;
+    NvU32 wpr2Lo;
+    NvU32 wpr2Hi;
+    NvU32 plm;
+    NvU32 ss0;
+    NvU32 ss1;
+
+    if (!_kgspCmp90hxEnabled(pGpu))
+        return NV_OK;
+
+    wpr2Lo = GPU_REG_RD32(pGpu, 0x001fa824U);
+    wpr2Hi = GPU_REG_RD32(pGpu, 0x001fa828U);
+    plm = 0;
+    for (attempt = 0; attempt < 2; attempt++)
+    {
+        GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+        GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+        NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+            _kgspCmp90hxRefillOpenPlmPayload(pGpu, pKernelGsp));
+
+        /* This V67 invocation opens PLM but intentionally does not boot RM. */
+        status = kgspExecuteBooterLoad_HAL(pGpu, pKernelGsp, booterLoadArgs);
+        plm = GPU_REG_RD32(pGpu, CMP90HX_FEAT_OVR_PLM);
+        NV_PRINTF(LEVEL_ERROR,
+            "CMP90HX: V67 attempt=%u status=0x%x PLM=0x%08x\n",
+            attempt, status, plm);
+        if (plm == 0xffffffffU)
+            break;
+    }
+    GPU_REG_WR32(pGpu, 0x001fa824U, wpr2Lo);
+    GPU_REG_WR32(pGpu, 0x001fa828U, wpr2Hi);
+    if (plm != 0xffffffffU)
+    {
+        NV_PRINTF(LEVEL_ERROR,
+            "CMP90HX: FEAT_OVR_PLM did not open (0x%08x)\n", plm);
+        return NV_ERR_INVALID_STATE;
+    }
+
+    /* The verified compute-only selector order is SS1 first, then SS0. */
+    GPU_REG_WR32(pGpu, CMP90HX_FEAT_OVR_SM_SPD_1, 0x00000008U);
+    ss1 = GPU_REG_RD32(pGpu, CMP90HX_FEAT_OVR_SM_SPD_1);
+    GPU_REG_WR32(pGpu, CMP90HX_FEAT_OVR_SM_SPD, 0x88888888U);
+    ss0 = GPU_REG_RD32(pGpu, CMP90HX_FEAT_OVR_SM_SPD);
+    if ((ss0 != 0x88888888U) || (ss1 != 0x00000008U))
+    {
+        NV_PRINTF(LEVEL_ERROR,
+            "CMP90HX: selector readback failed SS0=0x%08x SS1=0x%08x\n",
+            ss0, ss1);
+        return NV_ERR_INVALID_STATE;
+    }
+
+    NV_CHECK_OK_OR_RETURN(LEVEL_ERROR,
+        _kgspCmp90hxRestoreStockSignature(pGpu, pKernelGsp));
+    NV_PRINTF(LEVEL_ERROR,
+        "CMP90HX: compute selectors enabled PLM=0x%08x SS0=0x%08x SS1=0x%08x\n",
+        plm, ss0, ss1);
+    /* The bootstrap module intentionally stops here; systemd performs bus reset. */
+    return NV_ERR_INVALID_STATE;
+}
+
